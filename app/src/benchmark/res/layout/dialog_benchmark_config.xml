<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configure TAP Benchmark Test"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Message Count:"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/edit_message_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Number of messages (e.g., 50)"
        android:inputType="number"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Message Type:"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/spinner_message_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Message Size:"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/spinner_message_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Interval (ms):"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/edit_interval_ms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Interval between messages (e.g., 1000)"
        android:inputType="number"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Device Role:"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/spinner_device_role"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <CheckBox
        android:id="@+id/checkbox_auto_start_v2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto-start V2 mode if not active"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note: This will record detailed timing information for TAP message latency analysis."
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginTop="16dp" />

</LinearLayout>

