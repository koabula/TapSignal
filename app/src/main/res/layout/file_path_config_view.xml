<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/file_path_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/signal_text_primary"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/file_path_edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tap_edit_text_background"
            android:padding="12dp"
            android:textSize="14sp"
            android:textColor="@color/signal_text_primary"
            android:textColorHint="@color/signal_text_secondary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/file_path_browse_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/FilePathConfig__browse_button"
            android:textSize="12sp"
            android:minWidth="60dp"
            android:background="@drawable/tap_button_background"
            android:textColor="@color/signal_text_primary" />

    </LinearLayout>

    <TextView
        android:id="@+id/file_path_help_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/signal_text_secondary"
        android:visibility="gone" />

</LinearLayout> 